# Copier en .env (deploy.sh le génère automatiquement avec des secrets aléatoires).
DOMAIN=repas.example.fr
APP_URL=https://repas.example.fr
POSTGRES_USER=mise
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mise
# Trousseau AES-256-GCM des données de santé : "id:base64(32 octets)", la première chiffre.
# Générer : echo "k1:$(openssl rand -base64 32)"
DATA_ENCRYPTION_KEYS=k1:remplacer-par-openssl-rand-base64-32
PLANNER_TIME_LIMIT_S=10
PLANNER_WORKERS=8
METRICS_TOKEN=
LOG_LEVEL=info
WEB_BIND=127.0.0.1
WEB_PORT=3000
